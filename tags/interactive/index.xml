margin:1.5rem -1rem;padding:.9rem;border-width:1px;border-radius:12px}.dot-product-lab__layout{grid-template-columns:1fr}.dot-product-lab__stage{min-height:330px}.dot-product-lab canvas{height:330px}.dot-product-lab__steps{grid-template-columns:1fr}.dot-product-lab__header{align-items:center}.dot-product-lab h2{font-size:1.2rem}}
